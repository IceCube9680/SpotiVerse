# ================================================================
# SpotiVerse Bot - Environment Configuration
# ================================================================

# Pyrogram API credentials (REQUIRED from https://my.telegram.org)
API_ID=
API_HASH=
BOT_TOKEN=

# MongoDB Atlas URI (Optional - defaults to robust in-memory persistence if omitted)
MONGO_URI=

# Owner & Admin Telegram IDs
OWNER_ID=
ADMINS=
SUDO_USERS=
PREMIUM_USERS=

# Logging Channels (Optional Telegram channel IDs, e.g. -1001234567890)
LOG_CHANNEL=0
DOWNLOAD_LOG_CHANNEL=0

# Spotify credentials (Optional - uses anonymous web player fallback if omitted)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
YOUTUBE_API_KEY=

# ================================================================
# Premium & Feature Gate Settings
# ================================================================
# True = Premium features enforced for premium members; False = All unlocked
PREMIUM=True
FREE_USER_DAILY_LIMIT=5
PREMIUM_EXPIRY_WARNING_DAYS=7

# Download Concurrency & Queue Priority
MAX_CONCURRENT_DOWNLOADS=3
MAX_PREMIUM_CONCURRENT_DOWNLOADS=5
MAX_FREE_CONCURRENT_DOWNLOADS=2
PREMIUM_PRIORITY_WEIGHT=3

# Maintenance Mode Permissions
MAINTENANCE_ALLOW_PREMIUM=False
MAINTENANCE_ALLOW_ADMIN=True

# ================================================================
# Audio Formats, Quality & File Size Limits
# ================================================================
# Free Tier Audio Formats & Qualities
FREE_AUDIO_FORMATS=mp3
FREE_MP3_QUALITIES=64, 128, 192, 256, 320

# Premium Tier Audio Formats & Qualities
PREMIUM_AUDIO_FORMATS=mp3, flac, m4a, ogg, wav
PREMIUM_MP3_QUALITIES=64, 128, 192, 256, 320
PREMIUM_M4A_QUALITIES=128, 192, 256, 320
PREMIUM_OGG_QUALITIES=64, 96, 128, 160, 192, 256, 320
PREMIUM_WAV_BIT_DEPTHS=16, 24
PREMIUM_WAV_SAMPLE_RATES=44100, 48000, 96000

# Telegram Maximum Upload File Size in MB (Default 50MB)
MAX_AUDIO_FILE_SIZE_MB=50



# ================================================================
# Payment Gateway Configuration
# ================================================================
# Telegram Payments Provider Token (from @BotFather)
PAYMENT_PROVIDER_TOKEN=
# UPI ID for manual UPI QR / verification flow
PAYMENT_UPI_ID=icecube@upi

# ================================================================
# Optional Dynamic Premium Plan Overrides
# ================================================================
# PREMIUM_PLAN_1_NAME=1 Month
# PREMIUM_PLAN_1_PRICE=99
# PREMIUM_PLAN_1_DURATION=30d
# PREMIUM_PLAN_2_NAME=3 Months
# PREMIUM_PLAN_2_PRICE=249
# PREMIUM_PLAN_2_DURATION=90d
# PREMIUM_PLAN_3_NAME=6 Months
# PREMIUM_PLAN_3_PRICE=399
# PREMIUM_PLAN_3_DURATION=180d
